{
  "name": "shadow-squad",
  "version": "1.10.0",
  "description": "Browser-based tactical turn-based strategy game",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint js/ tests/",
    "lint:fix": "eslint js/ tests/ --fix",
    "validate": "npm run lint && npm run test && npm run test:e2e",
    "generate-assets": "node scripts/generate-assets.js",
    "build": "npm run generate-assets"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.57.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "game",
    "tactical",
    "hex",
    "turn-based"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodingSteve01/battlezone.git"
  }
}
